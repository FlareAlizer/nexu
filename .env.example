# В этом проекте переменные окружения разнесены по сервисам:
#   backend/.env.example   — API (БД, JWT, Telegram, S3, Kinescope, Sentry, лимиты)
#   frontend/.env.example  — сборка фронта (только публичные значения)
#
# Этот файл — шаблон .env, который лежит на проде рядом с docker-compose.yml:
# переменные бэкенда плюс пароль контейнера БД.
# Реальные .env НЕ коммитим (они в .gitignore).
POSTGRES_PASSWORD=
