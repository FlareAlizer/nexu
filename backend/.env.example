# Скопируй в backend/.env. Реальный .env НЕ коммитим.
# Пустые ключи внешних сервисов — это рабочий режим: включаются заглушки
# (файлы на диск вместо S3, уведомления в лог вместо Telegram). См. README.
DATABASE_URL=postgresql://nexu:nexu@localhost:5432/nexu
JWT_SECRET=change_me
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=30d
PORT=8000
# Origin фронта для CORS (в проде — https://ДОМЕН)
FRONTEND_ORIGIN=http://localhost:5173

# Telegram: бот @nexuu_school_bot (уведомления + Login Widget).
# Пусто → заглушка: текст уведомления пишется в лог API.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=nexuu_school_bot
# secret_token для вебхука бота: setWebhook?url=https://ДОМЕН/api/telegram/webhook&secret_token=...
TELEGRAM_WEBHOOK_SECRET=

# Kinescope. Пусто → в уроки заводятся id вида demo-* и работает плеер-заглушка.
KINESCOPE_API_TOKEN=
KINESCOPE_PROJECT_ID=

# S3 (Selectel / Yandex Object Storage) — файлы заданий, закрытый бакет.
# Пусто → заглушка: файлы в каталог STORAGE_LOCAL_DIR, ссылки через /api/files.
S3_ENDPOINT=
S3_REGION=ru-1
S3_BUCKET=nexu-submissions
S3_ACCESS_KEY=
S3_SECRET_KEY=
STORAGE_LOCAL_DIR=./.storage

# Sentry (мониторинг ошибок). Пусто → выключен.
SENTRY_DSN=

# Лимиты запросов с одного IP (п.4.2). Поднимать только для нагрузочного теста.
RATE_LIMIT_PER_MIN=100
LOGIN_RATE_LIMIT_PER_MIN=10

# Демо-данные (npm run seed): число учеников и пароль всех демо-аккаунтов
SEED_STUDENTS=5
SEED_PASSWORD=demo-nexu-2026
