# Скопируй в frontend/.env. Переменные читаются на сборке (vite), в браузер попадают открытым текстом —
# сюда только публичные значения, никаких секретов.

# username Telegram-бота для Login Widget
VITE_TELEGRAM_BOT_USERNAME=nexuu_school_bot

# Sentry: публичный DSN фронта. Пусто → мониторинг выключен и в бандл не попадает.
VITE_SENTRY_DSN=
